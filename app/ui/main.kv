#:import dp kivy.metrics.dp
#:import webbrowser webbrowser

<TTSLayout>:
    orientation: "vertical"
    padding: dp(12)
    spacing: dp(10)

    canvas.before:
        Color:
            rgba: BACKGROUND
        Rectangle:
            pos: self.pos
            size: self.size

    # Top Bar: Language Switcher
    BoxLayout:
        orientation: "horizontal"
        size_hint_y: None
        height: dp(35)
        spacing: dp(5)

        Widget:

        Button:
            text: "EN"
            size_hint_x: None
            width: dp(40)
            background_normal: ""
            background_color: RED_5 if root.current_lang == "en" else RED_2
            color: FOREGROUND
            bold: True
            on_release: root.change_language("en")

        Button:
            text: "ES"
            size_hint_x: None
            width: dp(40)
            background_normal: ""
            background_color: RED_5 if root.current_lang == "es" else RED_2
            color: FOREGROUND
            bold: True
            on_release: root.change_language("es")

        Button:
            text: "PT"
            size_hint_x: None
            width: dp(40)
            background_normal: ""
            background_color: RED_5 if root.current_lang == "pt" else RED_2
            color: FOREGROUND
            bold: True
            on_release: root.change_language("pt")

    Label:
        text: "TEXT-TO-SPEECH CONVERTER"
        color: FOREGROUND
        font_size: "24sp"
        bold: True
        size_hint_y: None
        height: dp(40)

    Label:
        text: root.t_subtitle
        color: RED_7
        font_size: "14sp"
        size_hint_y: None
        height: dp(24)

    BoxLayout:
        orientation: "horizontal" if self.width >= dp(650) else "vertical"
        spacing: dp(10)

        FileChooserListView:
            id: file_chooser
            path: app.user_data_dir
            filters: ["*.txt", "*.pdf"]
            multiselect: False
            size_hint_x: 0.65 if self.parent.width >= dp(650) else 1
            size_hint_y: 1

        BoxLayout:
            orientation: "vertical"
            spacing: dp(10)
            padding: dp(5)

            size_hint_x: 0.35 if self.parent.width >= dp(650) else 1
            size_hint_y: 1

            Label:
                text: root.t_selected_file_label
                color: FOREGROUND
                bold: True
                halign: "left"
                valign: "middle"
                text_size: self.size
                size_hint_y: None
                height: dp(32)

            Label:
                text: root.selected_file_display if root.selected_file_display else root.t_no_file
                color: RED_8
                halign: "left"
                valign: "top"
                text_size: self.width, None
                shorten: True
                shorten_from: "right"
                size_hint_y: None
                height: dp(55)

            Label:
                text: root.t_language
                color: FOREGROUND
                bold: True
                halign: "left"
                valign: "middle"
                text_size: self.size
                size_hint_y: None
                height: dp(32)

            Spinner:
                id: language_spinner
                text: "English"
                values:
                    [
                    "English",
                    "Spanish",
                    "Portuguese"
                    ]
                option_cls: "LanguageSpinnerOption"
                color: FOREGROUND
                background_normal: ""
                background_color: RED_2
                font_size: "16sp"
                text_size: self.size
                halign: "center"
                valign: "middle"
                padding: 0, 0
                size_hint_y: None
                height: dp(48)

            Button:
                text: root.t_select_btn
                color: FOREGROUND
                background_normal: ""
                background_color: RED_2
                font_size: "15sp"
                size_hint_y: None
                height: dp(48)
                disabled: root.is_converting
                on_release: root.select_file()

            Button:
                text: root.t_convert_btn
                color: BACKGROUND
                background_normal: ""
                background_color: CURSOR
                font_size: "15sp"
                bold: True
                size_hint_y: None
                height: dp(48)
                disabled: root.is_converting
                on_release: root.start_conversion()

            Widget:

            Label:
                text: root.status
                color: RED_7
                halign: "left"
                valign: "top"
                text_size: self.width, None
                size_hint_y: None
                height: dp(75)

    # Bottom Footer Signature (MIT Corporate)
    BoxLayout:
        orientation: "horizontal"
        size_hint_y: None
        height: dp(30)
        padding: dp(10)

        Widget:

        Button:
            text: "MIT LICENSE © necrisscript — LICENSED FOR COMMERCIAL USE"
            color: RED_7
            background_normal: ""
            background_color: 0, 0, 0, 0
            font_size: "11sp"
            bold: True
            size_hint: None, None
            size: self.texture_size[0] + dp(10), dp(30)
            on_release: webbrowser.open("https://github.com/necrisscript")

        Widget:
